{
  "name": "dbsdk",
  "version": "0.1.0",
  "description": "One typed SDK to create, manage, and query databases on Supabase, Neon, and PlanetScale Postgres: bring your provider API key, provision and manage resources through the management control plane, run parameterized SQL, and use Drizzle ORM over dbSDK connections. Honest capabilities, normalized errors, no silent failover.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "database",
    "postgresql",
    "postgres",
    "supabase",
    "neon",
    "planetscale",
    "sql",
    "sdk",
    "typescript",
    "management-api",
    "provisioning",
    "database-management",
    "control-plane"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "import": "./dist/adapters/postgres.js",
      "default": "./dist/adapters/postgres.js"
    },
    "./supabase": {
      "types": "./dist/adapters/supabase.d.ts",
      "import": "./dist/adapters/supabase.js",
      "default": "./dist/adapters/supabase.js"
    },
    "./neon": {
      "types": "./dist/adapters/neon.d.ts",
      "import": "./dist/adapters/neon.js",
      "default": "./dist/adapters/neon.js"
    },
    "./planetscale": {
      "types": "./dist/planetscale.d.ts",
      "import": "./dist/planetscale.js",
      "default": "./dist/planetscale.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle-interop/index.d.ts",
      "import": "./dist/drizzle-interop/index.js",
      "default": "./dist/drizzle-interop/index.js"
    },
    "./orm": {
      "types": "./dist/orm-facade/index.d.ts",
      "import": "./dist/orm-facade/index.js",
      "default": "./dist/orm-facade/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "import": "./dist/management/index.js",
      "default": "./dist/management/index.js"
    },
    "./management/testing": {
      "types": "./dist/management/testing.d.ts",
      "import": "./dist/management/testing.js",
      "default": "./dist/management/testing.js"
    },
    "./management/supabase": {
      "types": "./dist/management/supabase.d.ts",
      "import": "./dist/management/supabase.js",
      "default": "./dist/management/supabase.js"
    },
    "./management/neon": {
      "types": "./dist/management/neon.d.ts",
      "import": "./dist/management/neon.js",
      "default": "./dist/management/neon.js"
    },
    "./management/planetscale": {
      "types": "./dist/management/planetscale.d.ts",
      "import": "./dist/management/planetscale.js",
      "default": "./dist/management/planetscale.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "pg": "^8.16.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
