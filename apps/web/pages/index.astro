  .compat-table {
    width: 100%;
    margin-top: 26px;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 13px;
  }
  .compat-col-provider {
    width: 34%;
  }
  .compat-table th,
  .compat-table td {
    padding: 13px 12px 13px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }
  .compat-table thead th {
