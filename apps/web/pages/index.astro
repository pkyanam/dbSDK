  /* ---------- provider strip (marquee) ---------- */
  .strip {
    margin-top: 44px;
    border-block: 1px solid var(--line);
    padding: 18px 0;
    overflow: hidden;
    /* Fade both edges so the loop enters and exits softly. */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }
  .strip-track {
    display: flex;
    width: max-content;
    animation: dbsdk-marquee 28s linear infinite;
  }
  .strip:hover .strip-track,
  .strip:focus-within .strip-track {
    animation-play-state: paused;
  }
  @keyframes dbsdk-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .strip-list {
    display: flex;
    align-items: center;
    gap: 44px;
    /* Matches the internal gap so the marquee seam (translateX(-50%))
       has the same spacing as the rest of the loop, with no overlap. */
    padding-right: 44px;
    margin: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    list-style: none;
  }
  .strip-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .strip-icon {
    flex: none;
    width: 22px;
    height: 22px;
    /* Fill every path with the ink token, not the source SVG's own
       fills (some source marks ship chromatic fills), so the marks are
       monochrome and match the adjacent names in both themes. */
    color: var(--ink);
  }
  .strip-icon path {
    fill: currentColor;
  }
  .strip-name {
    white-space: nowrap;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .strip-note {
    margin: 14px 0 0;
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .strip-track {
      animation: none;
    }
    .strip-list[aria-hidden="true"] {
      display: none;
    }
    .strip {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* ---------- pillars ---------- */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
    margin-top: 52px;
  }
  .pillars article {
    padding: 28px 26px 28px 0;
  }
  .pillars article + article {
    border-left: 1px solid var(--line);
    padding-left: 26px;
  }
  .pillar-step {
    display: block;
    margin-bottom: 22px;
    font-size: 11px;
    color: var(--muted);
