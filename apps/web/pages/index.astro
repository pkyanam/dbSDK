  .home {
    --paper: var(--dbsdk-paper);
    --ink: var(--dbsdk-ink);
    --muted: var(--dbsdk-ink-soft);
    --line: var(--dbsdk-line);
    max-width: 1160px;
    margin: auto;
    padding: 64px 40px 56px;
    color: var(--ink);
    background: var(--paper);
  }
  .home * {
    box-sizing: border-box;
  }
  .home a {
    color: inherit;
    font-size: 13px;
    text-decoration: none;
    text-underline-offset: 4px;
  }
  .home a:hover {
    text-decoration: underline;
  }
  .home a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  /* ---------- hero ---------- */
  .hero-title {
    margin: 0 0 26px;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    /* Em-based so the tracking scales with the rendered size; fixed
       negative pixels caused clipped headline edges at 320px. */
    letter-spacing: -0.042em;
    color: var(--ink);
  }
  .hero-line {
    display: block;
  }
  .hero-copy {
    margin: 0 0 28px;
    max-width: 34rem;
    font-size: 17px;
    line-height: 1.8;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
  }
  /* Scoped above the global `.home a { color: inherit }` rule (class +
     class beats class + element) so the button keeps its declared
     contrast: ink background with paper text in light mode, and the
     inverse in dark mode. Hover/focus only dim opacity, no chroma. */
  .home .btn-primary {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    min-height: 46px;
    padding: 13px 18px;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
