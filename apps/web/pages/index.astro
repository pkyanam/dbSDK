  .pillar-copy {
    margin: 0;
    max-width: 24rem;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  /* ---------- compatibility table ----------
     A real 2D table at every viewport width, including phones: providers
     as rows, Create / Manage / Query as columns, compact rows, symbols
     with screen-reader labels. Fixed layout keeps the three status
     columns equal and lets the provider name wrap instead of overflowing. */
  .compat {
    /* .pillars already carries the bottom border above this section. */
    border-top: 0;
    padding-top: 28px;
  }
  .compat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 40px;
  }
  .compat-head .section-copy {
    max-width: none;
