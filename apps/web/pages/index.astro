---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;

/* ------------------------------------------------------------------ */
/* Adapter switcher data. One source of truth, serialized for the      */
/* client script. Code samples use the real public API of the SDK.     */
/* ------------------------------------------------------------------ */

const t = (cls: string, s: string) => `<span class="${cls}">${s}</span>`;
const K = (s: string) => t("tk-k", s);
const S = (s: string) => t("tk-s", s);
const C = (s: string) => t("tk-c", s);
const F = (s: string) => t("tk-f", s);
const V = (s: string) => t("tk-v", s);
const P = (s: string) => t("tk-p", s);

const stripTags = (html: string) => html.replace(/<[^>]+>/g, "");

const IMPORT_CORE =
  K("import") + " " + P("{ ") + V("createDatabase") + P(" }") + " " + K("from") + " " + S('"dbsdk"') + P(";");

const SHARED_QUERY_HTML =
  K("const") + " " + P("{ ") + V("rows") + P(", ") + V("rowCount") + P(", ") + V("command") + P(" }") + " " + P("= ") + K("await") + " " + V("db") + P(".") + F("sql") + P("`") + "\n" +
  "  " + V("select id, email from users") + "\n" +
  "  " + V("where id = ") + P("\${") + V("userId") + P("}") + "\n" +
  P("`") + P(";");

const SHARED_QUERY_TEXT = stripTags(SHARED_QUERY_HTML);

type CapState = "ok" | "warn" | "no";
type Tab = {
  id: string;
  name: string;
  sub: string;
  file: string;
  html: string;
  caps: { label: string; state: CapState; note: string }[];
  note: string;
  evidence: string;
};

const tabs: Tab[] = [
  {
    id: "postgres",
    name: "Postgres",
    sub: "TCP, any host",
    file: "postgres.ts",
    html:
      IMPORT_CORE + "\n" +
      K("import") + " " + P("{ ") + V("postgres") + P(" }") + " " + K("from") + " " + S('"dbsdk/postgres"') + P(";") + "\n\n" +
      K("const") + " " + V("db") + " " + P("= ") + F("createDatabase") + P("({") + "\n" +
      "  " + V("adapter") + P(": ") + F("postgres") + P("({") + "\n" +
      "    " + V("connectionString") + P(": ") + V("process") + P(".") + V("env") + P(".") + V("DATABASE_URL") + P(",") + "\n" +
      "    " + V("max") + P(": ") + S("10") + P(",") + "\n" +
      "  " + P("}),") + "\n" +
      P("});"),
    caps: [
      { label: "Interactive transactions", state: "ok", note: "db.transaction(callback)" },
      { label: "Atomic batch", state: "ok", note: "one connection, BEGIN to COMMIT" },
      { label: "Session state", state: "ok", note: "inside transaction() or raw; not across pooled queries" },
      { label: "Named prepared statements", state: "no", note: "unnamed protocol statements only" },
    ],
    note: "The plain Postgres adapter. Any host that speaks the wire protocol, including a local Docker instance for tests.",
    evidence: "Verified by fixtures and a live local PostgreSQL 17.",
  },
  {
    id: "supabase-direct",
    name: "Supabase",
    sub: "direct, port 5432",
    file: "supabase-direct.ts",
    html:
      IMPORT_CORE + "\n" +
      K("import") + " " + P("{ ") + V("supabase") + P(" }") + " " + K("from") + " " + S('"dbsdk/supabase"') + P(";") + "\n\n" +
      K("const") + " " + V("db") + " " + P("= ") + F("createDatabase") + P("({") + "\n" +
      "  " + V("adapter") + P(": ") + F("supabase") + P("({") + "\n" +
      "    " + C("// Dashboard URL plus ?sslmode=verify-full&sslrootcert=<CA path>") + "\n" +
      "    " + V("connectionString") + P(": ") + V("process") + P(".") + V("env") + P(".") + V("SUPABASE_DB_URL") + P(",") + "  " + C("// db.<ref>.supabase.co:5432") + "\n" +
      "    " + V("connectionMode") + P(": ") + S('"direct"') + P(",") + "\n" +
      "  " + P("}),") + "\n" +
      P("});"),
    caps: [
      { label: "Interactive transactions", state: "ok", note: "one leased connection" },
      { label: "Atomic batch", state: "ok", note: "one connection, BEGIN to COMMIT" },
      { label: "Session state", state: "ok", note: "dedicated session only; top-level queries pool-hop" },
      { label: "Named prepared statements", state: "no", note: "unnamed protocol statements only" },
    ],
    note: "The direct connection to your project's Postgres. TLS verification is on and uses Supabase's private CA, supplied by the sslrootcert URL parameter (docs/adapters/supabase).",
    evidence: "Verified by fixtures and configuration validation. A hosted Supabase project has not been exercised.",
  },
  {
    id: "supabase-session",
    name: "Supabase",
    sub: "session pooler, 5432",
    file: "supabase-session.ts",
    html:
      IMPORT_CORE + "\n" +
      K("import") + " " + P("{ ") + V("supabase") + P(" }") + " " + K("from") + " " + S('"dbsdk/supabase"') + P(";") + "\n\n" +
      K("const") + " " + V("db") + " " + P("= ") + F("createDatabase") + P("({") + "\n" +
      "  " + V("adapter") + P(": ") + F("supabase") + P("({") + "\n" +
      "    " + C("// Pooler URL plus ?sslmode=verify-full&sslrootcert=<CA path>") + "\n" +
      "    " + V("connectionString") + P(": ") + V("poolerUrl") + P(",") + "  " + C("// aws-<id>-<region>.pooler...:5432") + "\n" +
      "    " + V("connectionMode") + P(": ") + S('"session"') + P(",") + "\n" +
      "  " + P("}),") + "\n" +
      P("});"),
    caps: [
      { label: "Interactive transactions", state: "ok", note: "one leased connection" },
      { label: "Atomic batch", state: "ok", note: "one connection, BEGIN to COMMIT" },
      { label: "Session state", state: "ok", note: "dedicated session only; top-level queries pool-hop" },
      { label: "Named prepared statements", state: "no", note: "unnamed protocol statements only" },
    ],
    note: "The session pooler on port 5432. The pooler username must be postgres.<project-ref>; TLS uses Supabase's private CA the same way as direct mode (docs/adapters/supabase).",
    evidence: "Verified by fixtures and configuration validation. A hosted Supabase project has not been exercised.",
  },
  {
    id: "supabase-transaction",
    name: "Supabase",
    sub: "transaction pooler, 6543",
    file: "supabase-transaction.ts",
    html:
      IMPORT_CORE + "\n" +
      K("import") + " " + P("{ ") + V("supabase") + P(" }") + " " + K("from") + " " + S('"dbsdk/supabase"') + P(";") + "\n\n" +
      K("const") + " " + V("db") + " " + P("= ") + F("createDatabase") + P("({") + "\n" +
      "  " + V("adapter") + P(": ") + F("supabase") + P("({") + "\n" +
      "    " + C("// Pooler URL plus ?sslmode=verify-full&sslrootcert=<CA path>") + "\n" +
      "    " + V("connectionString") + P(": ") + V("poolerUrl") + P(",") + "  " + C("// transaction pooler, port 6543") + "\n" +
      "    " + V("connectionMode") + P(": ") + S('"transaction"') + P(",") + "\n" +
      "  " + P("}),") + "\n" +
      P("});") + "\n\n" +
      C("// Session-level SET, LISTEN and temp objects are") + "\n" +
      C("// refused before dispatch. Inside a transaction,") + "\n" +
      C("// SET LOCAL is allowed."),
    caps: [
      { label: "Interactive transactions", state: "ok", note: "one leased connection" },
      { label: "Atomic batch", state: "ok", note: "runs as a single transaction" },
      { label: "Session state", state: "no", note: "guarded before dispatch on the pooler" },
      { label: "Named prepared statements", state: "no", note: "unnamed protocol statements only" },
    ],
    note: "The transaction pooler on port 6543, sized for serverless workloads. Session-level statements are rejected before dispatch rather than being sent to a pooler that cannot honor them.",
    evidence: "Mode semantics verified against a live local PostgreSQL through the transaction path.",
  },
  {
    id: "neon-http",
    name: "Neon",
    sub: "HTTP transport",
    file: "neon-http.ts",
    html:
      IMPORT_CORE + "\n" +
      K("import") + " " + P("{ ") + V("neon") + P(" }") + " " + K("from") + " " + S('"dbsdk/neon"') + P(";") + "\n\n" +
      K("const") + " " + V("db") + " " + P("= ") + F("createDatabase") + P("({") + "\n" +
      "  " + V("adapter") + P(": ") + F("neon") + P("({") + "\n" +
      "    " + V("connectionString") + P(": ") + V("process") + P(".") + V("env") + P(".") + V("DATABASE_URL") + P(",") + "\n" +
      "    " + V("transport") + P(": ") + S('"http"') + P(",") + "  " + C("// the default") + "\n" +
      "  " + P("}),") + "\n" +
      P("});") + "\n\n" +
      C("// db.transaction() is refused before dispatch.") + "\n" +
      C("// db.batch(statements) is one native HTTP") + "\n" +
      C("// round-trip, atomic by default."),
    caps: [
      { label: "Interactive transactions", state: "no", note: "refused before dispatch" },
      { label: "Atomic batch", state: "ok", note: "one native HTTP round-trip" },
      { label: "Session state", state: "no", note: "HTTP is stateless" },
      { label: "Named prepared statements", state: "no", note: "none over HTTP" },
    ],
    note: "One HTTP request per statement or batch, wherever fetch runs. No sockets to hold open, and no interactive transactions.",
    evidence: "HTTP path verified against a local Neon protocol proxy in front of PostgreSQL 17.",
  },
  {
    id: "neon-websocket",
    name: "Neon",
    sub: "WebSocket transport",
    file: "neon-websocket.ts",
    html:
      IMPORT_CORE + "\n" +
      K("import") + " " + P("{ ") + V("neon") + P(" }") + " " + K("from") + " " + S('"dbsdk/neon"') + P(";") + "\n\n" +
      K("const") + " " + V("db") + " " + P("= ") + F("createDatabase") + P("({") + "\n" +
      "  " + V("adapter") + P(": ") + F("neon") + P("({") + "\n" +
      "    " + V("connectionString") + P(": ") + V("process") + P(".") + V("env") + P(".") + V("DATABASE_URL") + P(",") + "\n" +
      "    " + V("transport") + P(": ") + S('"websocket"') + P(",") + "\n" +
      "  " + P("}),") + "\n" +
      P("});") + "\n\n" +
      C("// Keep the pool within one request when") + "\n" +
      C("// running in a serverless runtime."),
    caps: [
      { label: "Interactive transactions", state: "ok", note: "short-lived pool per transaction" },
      { label: "Atomic batch", state: "ok", note: "one connection" },
      { label: "Session state", state: "warn", note: "direct endpoint, dedicated session; pooled hosts: no." },
      { label: "Named prepared statements", state: "no", note: "unnamed protocol statements only" },
    ],
    note: "The Neon driver's WebSocket pool for interactive transactions. Session state holds on a dedicated session over the direct endpoint; pooled hosts report it unavailable.",
    evidence: "Verified by fixtures. Both Neon transports are implemented in the adapter source.",
  },
];

const tabsJson = JSON.stringify(tabs);
const firstTab = tabs[0];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{ title: "dbSDK: one SQL surface for Postgres", description: config.description }}
>
  <!-- ================= HERO ================= -->
  <header class="dk-hero">
    <div class="dk-shell dk-hero-grid">
      <div class="dk-hero-copy">
        <h1 class="dk-h1">
          <span class="dk-h1-line">One SQL surface.</span>
          <span class="dk-h1-line dk-h1-accent">Every Postgres.</span>
        </h1>
        <p class="dk-lede">
          dbSDK is a typed PostgreSQL client for Supabase and Neon. Parameterized
          queries through db.sql, one result shape on every adapter, transports
          you choose on purpose, and errors that tell the truth when a
          connection drops.
        </p>
        <div class="dk-cta-row">
          <a class="dk-cta" href="/docs/getting-started">Read the docs</a>
          <a class="dk-cta dk-cta-ghost" href="https://github.com/pkyanam/dbSDK" rel="noopener">View on GitHub</a>
        </div>
        <p class="dk-facts">
          PostgreSQL only, on purpose <span aria-hidden="true">·</span> MIT
          licensed <span aria-hidden="true">·</span> Supabase and Neon launch
          adapters
        </p>
      </div>

      <figure class="dk-plate" data-art-slot="hero-plate">
        <picture>
          <source
            type="image/webp"
            srcset="/brand/banner-v2-768.webp 768w, /brand/banner-v2-1280.webp 1280w, /brand/banner-v2.webp 1536w"
            sizes="(max-width: 60rem) 92vw, 32rem"
          />
          <img
            src="/brand/banner-v2.webp"
            alt="Generated dbSDK artwork: muted blue connection lines converging into ordered navy rows with one red signal node."
            width="1536"
            height="1024"
            loading="eager"
            decoding="async"
          />
        </picture>
      </figure>
    </div>

    <div class="dk-shell">
      <p class="dk-masthead" aria-hidden="true">
        <span class="dk-masthead-db">db</span><span class="dk-masthead-sdk">SDK</span>
      </p>
    </div>
  </header>

  <!-- ================= SWITCHER ================= -->
  <section class="dk-section" id="switcher">
    <div class="dk-shell dk-head-grid">
      <h2 class="dk-h2">
        Swap the adapter.<br />Nothing else moves.
      </h2>
      <p class="dk-head-sub">
        Six connection modes, one client. You declare the mode you want, dbSDK
        validates it, refuses what it cannot honor, and never switches anything
        behind your back. The adapter docs also cover a seventh documented
        combination: Neon HTTP queries with transactions carried over TCP via
        <code>transactionTransport: "postgres"</code>.
      </p>
    </div>

    <div class="dk-shell">
      <div class="dk-switcher" id="adapter-switcher">
        <div class="dk-rail">
          <div class="dk-tabs" role="tablist" aria-label="Adapter and transport" aria-orientation="vertical">
            {tabs.map((tab, i) => (
              <button
                role="tab"
                class="dk-tab"
                id={`dk-tab-${tab.id}`}
                data-tab={tab.id}
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls="dk-panel"
                tabindex={i === 0 ? 0 : -1}
                type="button"
              >
                <span class="dk-tab-name">{tab.name}</span>
                <span class="dk-tab-sub">{tab.sub}</span>
              </button>
            ))}
          </div>
          <div class="dk-rail-note">
            <p class="dk-note" id="dk-note">{firstTab.note}</p>
            <p class="dk-evidence" id="dk-evidence">{firstTab.evidence}</p>
          </div>
        </div>

        <div
          class="dk-stage"
          id="dk-panel"
          role="tabpanel"
          aria-labelledby={`dk-tab-${firstTab.id}`}
          tabindex="0"
        >
          <div class="dk-stage-top">
            <div class="dk-code">
              <div class="dk-code-bar">
                <span class="dk-code-file" id="dk-file">{firstTab.file}</span>
                <button class="dk-copy" id="dk-copy" type="button" aria-label="Copy code example">
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
                    <rect x="5.5" y="5.5" width="8" height="8" rx="1.2"></rect>
                    <path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"></path>
                  </svg>
                  <span class="dk-copy-label">Copy</span>
                </button>
              </div>
              <pre class="dk-code-pre" id="dk-code" set:html={firstTab.html} />
            </div>

            <aside class="dk-caps">
              <ul class="dk-caps-list" id="dk-caps">
                {firstTab.caps.map((cap) => (
                  <li class={`dk-cap dk-cap-${cap.state}`}>
                    <span class="dk-cap-dot" aria-hidden="true"></span>
                    <div>
                      <p class="dk-cap-label">{cap.label}</p>
                      <p class="dk-cap-note">{cap.note}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </aside>
          </div>

          <div class="dk-shared">
            <div class="dk-shared-head">
              <span class="dk-shared-label">The same statement on every adapter</span>
              <span class="dk-shared-note">setup changes, the query does not</span>
            </div>
            <div class="dk-shared-body">
              <pre class="dk-shared-code" id="dk-shared" set:html={SHARED_QUERY_HTML} />
              <div class="dk-result">
                <p class="dk-result-label">Example result</p>
                <pre class="dk-result-pre">{`{
  "rows": [
    { "id": "usr_8f2c41", "email": "ada@example.com" }
  ],
  "rowCount": 1,
  "command": "SELECT"
}`}</pre>
                <p class="dk-result-note">
                  Identical envelope on every adapter: rows, rowCount, and the
                  PostgreSQL command tag when one is reported. Real output
                  arrives when you connect your own database.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CAPABILITIES ================= -->
  <section class="dk-section dk-section-alt" id="capabilities">
    <div class="dk-shell dk-head-grid">
      <h2 class="dk-h2">
        Capabilities,<br />stated plainly.
      </h2>
      <p class="dk-head-sub">
        What each transport supports, what it refuses, and how each claim was
        verified. Unsupported operations fail before dispatch. A supported
        write can still fail in flight: an outcome the client cannot know is
        reported as indeterminate and is never retried on your behalf.
      </p>
    </div>

    <div class="dk-shell">
      <div class="dk-table-wrap">
        <table class="dk-table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Postgres (TCP)</th>
              <th scope="col">Supabase direct</th>
              <th scope="col">Supabase session</th>
              <th scope="col">Supabase transaction</th>
              <th scope="col">Neon HTTP</th>
              <th scope="col">Neon WebSocket</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Transport</th>
              <td><code class="dk-mono">tcp</code></td>
              <td><code class="dk-mono">tcp</code></td>
              <td><code class="dk-mono">tcp</code></td>
              <td><code class="dk-mono">tcp</code></td>
              <td><code class="dk-mono">http</code></td>
              <td><code class="dk-mono">websocket</code></td>
            </tr>
            <tr>
              <th scope="row">Parameterized query()</th>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
            </tr>
            <tr>
              <th scope="row">Interactive transaction()</th>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">one leased connection</span></td>
              <td><span class="dk-cell dk-cell-no">refused before dispatch</span></td>
              <td><span class="dk-cell dk-cell-ok">short-lived pool per transaction</span></td>
            </tr>
            <tr>
              <th scope="row">Atomic batch()</th>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
              <td><span class="dk-cell dk-cell-ok">one native HTTP round-trip</span></td>
              <td><span class="dk-cell dk-cell-ok">supported</span></td>
            </tr>
            <tr>
              <th scope="row">Session state (SET, LISTEN, temp objects)</th>
              <td><span class="dk-cell dk-cell-ok">dedicated session</span></td>
              <td><span class="dk-cell dk-cell-ok">dedicated session</span></td>
              <td><span class="dk-cell dk-cell-ok">dedicated session</span></td>
              <td><span class="dk-cell dk-cell-no">guarded before dispatch</span></td>
              <td><span class="dk-cell dk-cell-no">not supported</span></td>
              <td><span class="dk-cell dk-cell-spec">direct endpoint, dedicated session; pooled hosts: no</span></td>
            </tr>
            <tr>
              <th scope="row">Verified by</th>
              <td>fixtures and a live local PostgreSQL</td>
              <td>fixtures and configuration validation</td>
              <td>fixtures and configuration validation</td>
              <td>fixtures and a live local PostgreSQL</td>
              <td>fixtures and a live local Neon proxy</td>
              <td>fixtures</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="dk-table-foot">
        <p>
          Session state lives on a dedicated session: it holds inside
          <code class="dk-mono">transaction()</code>, which leases one
          connection, or on a client reached through
          <code class="dk-mono">db.raw</code>. Top-level
          <code class="dk-mono">db.sql</code> and
          <code class="dk-mono">db.query</code> calls may run on different
          pooled connections, so session state does not persist between them,
          including on a direct endpoint behind a local pool.
        </p>
        <p>
          All TCP transports use unnamed protocol statements; dbSDK never
          creates reusable named prepared statements. The HTTP transport has
          none. Evidence vocabulary: <strong>fixtures</strong> means verified by
          the automated test suite against fixtures or local servers, and <strong>configuration validation</strong> means the adapter proves the
          connection string matches the declared mode before connecting. Nothing
          is claimed as verified against a hosted provider until it has been run
          that way.
        </p>
        <p>
          For trusted server-side applications. Connection roles determine
          access; dbSDK does not attach Supabase user identity to a SQL
          connection.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= GUARANTEES ================= -->
  <section class="dk-section dk-section-navy" id="guarantees">
    <div class="dk-shell dk-head-grid dk-head-grid-navy">
      <h2 class="dk-h2">
        What dbSDK<br />will not do.
      </h2>
      <p class="dk-head-sub">
        These are design decisions, not missing features. They hold on every
        adapter, and they are the reason the client stays small enough to
        reason about.
      </p>
    </div>

    <div class="dk-shell">
      <ul class="dk-guarantees">
        <li>
          <h3>No silent failover</h3>
          <p>
            Switching databases is your decision. The client never reroutes a
            query to another provider, and it never silently rewrites the
            endpoint you declared.
          </p>
        </li>
        <li>
          <h3>No automatic replay of writes</h3>
          <p>
            If a connection drops after a write is sent, the outcome is reported
            as indeterminate. Nothing is retried on your behalf; your
            application decides what happened.
          </p>
        </li>
        <li>
          <h3>No endpoint guessing</h3>
          <p>
            Connection strings are used exactly as given. When a string
            contradicts the declared connection mode, the adapter fails loudly
            before connecting.
          </p>
        </li>
        <li>
          <h3>No schema tooling in the current version</h3>
          <p>
            Migrations, branching, provisioning, realtime, storage and auth are
            separate concerns. dbSDK does one job: typed, parameterized SQL over
            real Postgres drivers.
          </p>
        </li>
        <li>
          <h3>No browser sessions</h3>
          <p>
            dbSDK is for trusted server-side applications. End-user identity is
            not attached to a SQL connection automatically; connection roles
            determine access.
          </p>
        </li>
