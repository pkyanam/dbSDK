/* Compatibility table: the one honest status surface on the homepage.
   Rendered as a real 2D table on every viewport (never collapsed into
   per-provider blocks), one row per provider, Create / Manage / Query
   columns. Cell vocabulary is exactly "Supported" / "Planned" /
   "Not applicable"; each cell shows a monochrome mark with the
   full word available to screen readers. Supabase and Neon create/manage
   are Supported: both management adapters are implemented against their
   official APIs with offline/local test evidence (hosted requests are not
   part of the evidence; the providers answer for credentials and plan
   tiers). The PostgreSQL connector wraps a database you already have:
   there is no provider API for it to call, so create/manage are "Not
   applicable". Update these rows as adapters land; the management docs
   and the capability descriptor are the canonical sources. */
const SUPPORTED = { mark: "\u2713", label: "Supported" };
const PLANNED = { mark: "\u25CB", label: "Planned" };
const NOT_APPLICABLE = { mark: "\u2014", label: "Not applicable" };

/* Map each table row to the brand mark shown beside its name. Brands,
   not products: AWS RDS and Aurora share the AWS mark, Google Cloud SQL
   and AlloyDB share the Google Cloud mark. */
const providerMark = (provider: string) => {
  if (provider.startsWith("AWS")) return brands.find((b) => b.name === "AWS");
  if (provider.startsWith("Google")) {
    return brands.find((b) => b.name === "Google Cloud");
  }
  return brands.find((b) => b.name === provider);
};

const compatibility = [
  { provider: "AWS RDS", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "AWS Aurora", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "Google Cloud SQL", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "Google AlloyDB", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "Supabase", create: SUPPORTED, manage: SUPPORTED, query: SUPPORTED },
  { provider: "Neon", create: SUPPORTED, manage: SUPPORTED, query: SUPPORTED },
  { provider: "Heroku", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "PlanetScale", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "Convex", create: PLANNED, manage: PLANNED, query: PLANNED },
  { provider: "PostgreSQL", create: NOT_APPLICABLE, manage: NOT_APPLICABLE, query: SUPPORTED },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  // Bespoke social share image (design/assets master, v2 liquid-chrome
  // wordmark): overrides the generated OG card for the home only; docs pages
  // keep their generated cards. Root-relative so it resolves against the
  // deployment site for crawlers; ogImageSize must match the shipped bitmap.
  ogImage="/social-card-v2.png"
  ogImageAlt="dbSDK wordmark in liquid metal chrome on a white background"
  ogImageSize={{ width: 1200, height: 630 }}
  page={{
    title: "dbSDK: All your databases. In the palm of your hand.",
  }}
>
  <main class="home">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <h1 class="hero-title">
        <span class="hero-line">All your databases.</span>
        <span class="hero-line">In the palm of your hand.</span>
      </h1>
      <p class="hero-copy">
        Create, manage, and query databases with one SDK.
      </p>
      <nav class="hero-actions" aria-label="Get started">
        <a class="btn-primary" href="/docs/getting-started">
