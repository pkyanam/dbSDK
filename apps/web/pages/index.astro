<script type="application/json" id="dk-tabs-data" set:html={tabsJson} />

<script>
  const tabsEl = document.getElementById("dk-tabs-data");
  const panel = document.getElementById("dk-panel");
  const codeEl = document.getElementById("dk-code") as HTMLElement;
  const fileEl = document.getElementById("dk-file") as HTMLElement;
  const capsEl = document.getElementById("dk-caps") as HTMLElement;
  const noteEl = document.getElementById("dk-note") as HTMLElement;
  const evidenceEl = document.getElementById("dk-evidence") as HTMLElement;
  const sharedEl = document.getElementById("dk-shared") as HTMLElement;
  const copyBtn = document.getElementById("dk-copy") as HTMLButtonElement;
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".dk-tab"));

  type Cap = { label: string; state: "ok" | "warn" | "no"; note: string };
  type Tab = {
    id: string;
    name: string;
    sub: string;
    file: string;
    html: string;
    caps: Cap[];
    note: string;
    evidence: string;
  };

  const tabs: Tab[] = tabsEl ? (JSON.parse(tabsEl.textContent ?? "[]") as Tab[]) : [];
  const sharedQuery = sharedEl ? sharedEl.textContent ?? "" : "";
  let activeId = tabButtons.find((b) => b.getAttribute("aria-selected") === "true")?.dataset.tab;

  function render(id?: string) {
    const tab = tabs.find((t) => t.id === id);
    if (!tab || !panel) return;
    activeId = tab.id;
    codeEl.innerHTML = tab.html;
    fileEl.textContent = tab.file;
    noteEl.textContent = tab.note;
    evidenceEl.textContent = tab.evidence;
    panel.setAttribute("aria-labelledby", `dk-tab-${tab.id}`);
    capsEl.innerHTML = tab.caps
      .map(
        (cap) =>
          `<li class="dk-cap dk-cap-${cap.state}"><span class="dk-cap-dot" aria-hidden="true"></span><div><p class="dk-cap-label">${cap.label}</p><p class="dk-cap-note">${cap.note}</p></div></li>`
      )
      .join("");
    tabButtons.forEach((btn) => {
      const selected = btn.dataset.tab === tab.id;
      btn.setAttribute("aria-selected", selected ? "true" : "false");
      btn.tabIndex = selected ? 0 : -1;
    });
  }

  function onKeydown(event: KeyboardEvent) {
    const keys = ["ArrowDown", "ArrowRight", "ArrowUp", "ArrowLeft", "Home", "End"];
    if (!keys.includes(event.key)) return;
    event.preventDefault();
    const current = tabButtons.findIndex((b) => b.dataset.tab === activeId);
    let next = current;
    if (event.key === "ArrowDown" || event.key === "ArrowRight") next = (current + 1) % tabButtons.length;
    if (event.key === "ArrowUp" || event.key === "ArrowLeft") next = (current - 1 + tabButtons.length) % tabButtons.length;
    if (event.key === "Home") next = 0;
    if (event.key === "End") next = tabButtons.length - 1;
    const target = tabButtons[next];
    if (target) {
      render(target.dataset.tab);
      target.focus();
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => render(btn.dataset.tab));
    btn.addEventListener("keydown", onKeydown);
  });

  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      const tab = tabs.find((t) => t.id === activeId);
      if (!tab) return;
      const text = tab.html.replace(/<[^>]+>/g, "") + "\n\n" + sharedQuery;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        document.body.appendChild(area);
        area.select();
        document.execCommand("copy");
        area.remove();
      }
      const label = copyBtn.querySelector(".dk-copy-label");
      if (label) {
        label.textContent = "Copied";
        window.setTimeout(() => {
          label.textContent = "Copy";
        }, 1600);
      }
    });
  }

  render(activeId);
</script>

